    "m_SourceType": 1,
    "m_FunctionName": "hash32",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 p3 = frac(float3(p.xyx) * float3(.1031, .1030, .0973));\r\np3 += dot(p3, p3.yxz+33.33);\r\n_out = frac((p3.xxy+p3.yzz)*p3.zyx);"
}

