  m_Script: {fileID: 11500000, guid: d01270efd3285ea4a9d6c555cb0a8027, type: 3}
  m_Name: VFXUI
  m_EditorClassIdentifier: 
  groupInfos: []
  stickyNoteInfos:
  - title: Update?
    position:
      serializedVersion: 2
      x: 809
      y: 485
      width: 247
      height: 100
    contents: Here, the VFx doesn't need any update context as it has no lifetime,
      the velocity and position are not changing and we don't need to apply forces
    theme: 
    textSize: Small
    colorTheme: 1
  - title: Init
    position:
      serializedVersion: 2
      x: 714
      y: 159
      width: 212
      height: 100
    contents: When there is no set position node, the position is by default set
      a 0.0.0 . so in our case we didn't need to add a position block, and we don't
      need a lifetime either
    theme: 
    textSize: Small
    colorTheme: 1
  - title: ShaderGraph
    position:
      serializedVersion: 2
      x: 732
      y: 843
      width: 199
      height: 100
    contents: the look of our fire is controlled by a shadergraph with exposed properties
    theme: 
    textSize: Small
    colorTheme: 1
  categories: []
  uiBounds:
    serializedVersion: 2
    x: 714
    y: -353
    width: 651
    height: 1697
